<UserControl x:Class="Autopatch.Demo.WPF.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="📊 Live Statistics" Style="{StaticResource HeaderStyle}"/>
        
        <!-- Statistics Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Total Orders -->
            <Border Grid.Column="0" BorderBrush="LightBlue" BorderThickness="2" 
                    Margin="5" Padding="10" CornerRadius="5" Background="AliceBlue">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="Active Orders" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalOrders}" FontSize="28" FontWeight="Bold" 
                              HorizontalAlignment="Center" Foreground="DarkBlue"/>
                    <TextBlock Text="in system" FontSize="10" HorizontalAlignment="Center" Foreground="Gray"/>
                </StackPanel>
            </Border>
            
            <!-- Active Drivers -->
            <Border Grid.Column="1" BorderBrush="LimeGreen" BorderThickness="2" 
                    Margin="5" Padding="10" CornerRadius="5" Background="LightGreen">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🚗" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="Active Drivers" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveDrivers}" FontSize="28" FontWeight="Bold" 
                              HorizontalAlignment="Center" Foreground="DarkGreen"/>
                    <TextBlock Text="online" FontSize="10" HorizontalAlignment="Center" Foreground="Gray"/>
                </StackPanel>
            </Border>
            
            <!-- Average Delivery Time -->
            <Border Grid.Column="2" BorderBrush="Orange" BorderThickness="2" 
                    Margin="5" Padding="10" CornerRadius="5" Background="PapayaWhip">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⏱️" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="Avg Delivery" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AverageDeliveryTime, StringFormat='{}{0:F1}'}" 
                              FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="DarkOrange"/>
                    <TextBlock Text="minutes" FontSize="10" HorizontalAlignment="Center" Foreground="Gray"/>
                </StackPanel>
            </Border>
            
            <!-- Orders Per Hour -->
            <Border Grid.Column="3" BorderBrush="Purple" BorderThickness="2" 
                    Margin="5" Padding="10" CornerRadius="5" Background="Lavender">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📈" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="Orders/Hour" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding OrdersPerHour}" FontSize="28" FontWeight="Bold" 
                              HorizontalAlignment="Center" Foreground="Purple"/>
                    <TextBlock Text="current rate" FontSize="10" HorizontalAlignment="Center" Foreground="Gray"/>
                </StackPanel>
            </Border>
            
        </Grid>
        
    </Grid>
</UserControl>
