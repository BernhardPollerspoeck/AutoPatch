{
  "name": "@autopatch/client",
  "version": "1.0.0",
  "description": "JavaScript/TypeScript client for AutoPatch real-time synchronization framework",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "prepare": "npm run build",
    "example:react": "cd examples/react-demo && npm start"
  },
  "keywords": [
    "autopatch",
    "signalr",
    "real-time",
    "synchronization",
    "json-patch",
    "typescript",
    "javascript"
  ],
  "author": "AutoPatch Contributors",
  "license": "MIT",
  "dependencies": {
    "@microsoft/signalr": "^8.0.0",
    "fast-json-patch": "^3.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BernhardPollerspoeck/AutoPatch.git",
    "directory": "src/Autopatch.Client.JS"
  },
  "bugs": {
    "url": "https://github.com/BernhardPollerspoeck/AutoPatch/issues"
  },
  "homepage": "https://github.com/BernhardPollerspoeck/AutoPatch#readme",
  "files": [
    "dist",
    "README.md"
  ]
}
